  "info": {
    "title": "F-POS API",
    "description": "API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Enter registered username of the user"
          },
          "password": {
            "type": "string",
            "description": "Enter password of the user"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "CompanyContactDto": {
        "type": "object",
        "properties": {
          "primaryEmail": {
            "type": "string"
          },
          "primaryPhone": {
            "type": "string"
          },
          "alternatePhone": {
            "type": "string"
          },
          "website": {
            "type": "string"
          }
        },
        "required": [
          "primaryEmail",
          "primaryPhone"
        ]
      },
      "CompanyAddressDto": {
        "type": "object",
        "properties": {
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "example": "IN"
          }
        },
        "required": [
          "line1",
          "city",
          "state",
          "postalCode",
          "country"
        ]
      },
      "CompanyTaxIdentifiersDto": {
        "type": "object",
        "properties": {
          "vatNumber": {
            "type": "string"
          }
        }
      },
      "CreateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "legalName": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "industry": {
            "type": "string",
            "enum": [
              "supermarket",
              "spare_parts",
              "dress_shop",
              "pharmacy",
              "electronics",
              "general_retail",
              "wholesale",
              "other"
            ]
          },
          "businessType": {
            "type": "string",
            "enum": [
              "retail",
              "wholesale",
              "retail_wholesale",
              "service"
            ]
          },
          "contact": {
            "$ref": "#/components/schemas/CompanyContactDto"
          },
          "address": {
            "$ref": "#/components/schemas/CompanyAddressDto"
          },
          "taxIdentifiers": {
            "$ref": "#/components/schemas/CompanyTaxIdentifiersDto"
          }
        },
        "required": [
          "name",
          "code",
          "slug",
          "industry",
          "businessType",
          "contact",
          "address"
        ]
      },
      "UpdateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "legalName": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "industry": {
            "type": "string",
            "enum": [
              "supermarket",
              "spare_parts",
              "dress_shop",
              "pharmacy",
              "electronics",
              "general_retail",
              "wholesale",
              "other"
            ]
          },
          "businessType": {
            "type": "string",
            "enum": [
              "retail",
              "wholesale",
              "retail_wholesale",
              "service"
            ]
          },
          "contact": {
            "$ref": "#/components/schemas/CompanyContactDto"
          },
          "address": {
            "$ref": "#/components/schemas/CompanyAddressDto"
          },
          "taxIdentifiers": {
            "$ref": "#/components/schemas/CompanyTaxIdentifiersDto"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_verification",
              "active",
              "suspended",
              "inactive"
            ]
          }
        }
      }
    }
  }
}